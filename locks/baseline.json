  "engine": {
    "appliedPatches": [
      {
        "id": "arena-browser-host-stop",
        "paths": [
          "code/sys/sys_main.c"
        ],
        "rationale": "The embedding host needs an Emscripten-only, engine-thread handoff into ioq3's complete normal quit path so stop requests release the live runtime honestly.",
        "upstreamStatus": "not-submitted"
      },
      {
        "id": "arena-browser-memory-growth",
        "paths": [
          "cmake/platforms/emscripten.cmake"
        ],
        "rationale": "The Emscripten client linked a fixed heap with no growth, so the shipped module aborts rather than slows down once a content set exceeds it; starting at the same figure and allowing growth to Emscripten's own default maximum charges the extra memory only to the sessions that use it.",
        "upstreamStatus": "not-submitted"
      },
      {
        "id": "arena-browser-relay-boundary",
        "paths": [
          "code/client/cl_main.c",
          "code/qcommon/common.c",
          "code/qcommon/net_chan.c",
          "code/qcommon/net_ip.c",
          "code/qcommon/qcommon.h",
          "code/sys/sys_unix.c"
        ],
        "rationale": "The browser client needs a fail-closed WebTransport datagram boundary with bounded polling, emitted-size and destination enforcement, safe refusal accounting, a formatted-connect limit, neutralized server-browser commands and Web Crypto randomness.",
        "upstreamStatus": "not-submitted"
      },
      {
        "id": "arena-netchan-fragment-size",
        "paths": [
          "code/qcommon/net_chan.c"
        ],
        "rationale": "The symmetric 704-byte protocol fragment constant keeps current and legacy client/server fragment headers below the measured relay inner-datagram floor while preserving the existing netchan reassembly grammar.",
        "upstreamStatus": "not-submitted"
      },
      {
        "id": "arena-relay-rate-limit-buckets",
        "paths": [
          "code/server/server.h",
          "code/server/sv_init.c",
          "code/server/sv_main.c"
        ],
        "rationale": "Managed relay clients share one visible IP address, so an explicit default-off server cvar can include relay-controlled live source ports in connectionless rate-limit buckets without changing open-Internet defaults.",
        "upstreamStatus": "not-submitted"
      },
      {
        "id": "renderergl2-glsl-es-highp",
        "paths": [
          "code/renderergl2/tr_glsl.c"
        ],
        "rationale": "GLSL ES stages were emitted with a mediump default float precision, which cannot hold this renderer's world-unit fragment arithmetic and draws lightmapped surfaces saturated white.",
        "upstreamStatus": "not-submitted"
      }
    ],
